    "bloom": {
      "$description": "bloom: CRT halo. Goes on structure, chrome and headings ONLY. Never on paragraph text — a halo there costs legibility and buys nothing. Each is a spread of a colour already in the palette.",
      "$extensions": {
        "csc": {
          "variants": {
            "hacker-light": {
              "$description": "bloom, reinterpreted as shadow. Same token names, opposite physics: on a dark ground these are light spilling outward, on paper they are the object casting down. Alphas are low — paper does not glow."
            },
            "cyber": {
              "$description": "bloom: CRT halo. Goes on structure, chrome and headings ONLY. Never on paragraph text — a halo there costs legibility and buys nothing. Alphas run slightly under the `hacker` values because the source colour is brighter; matching them numerically would smear."
            }
          }
        }
      },
