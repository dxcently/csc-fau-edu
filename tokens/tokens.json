      "life": {
        "$type": "color",
        "$value": "rgba( 255, 77, 77, .60 )",
        "$extensions": {
          "csc": {
            "comment": "the Game of Life on the board (§18). Its own token, not --wf-rain: this variant runs the field in red where the rain is green. Red is budgeted here (design-spec §0.1, max 3 per viewport) and a field of cells would blow that on its own — the alpha and .wf-life's opacity together keep it a texture, well under anything that reads as a red element.",
            "variants": {
              "hacker-light": {
                "$value": "rgba( 140, 130, 240, .40 )",
                "comment": "the Game of Life on the board (§18). Daylight: cells are solid blocks, so this sat below the rain's alpha at first. Raised twice against paper — at .20 the field still read as nothing on a white ground. Alpha is the lever, not the literal: over paper the composite darkness is alpha x how far the colour sits below the ground, so moving the blue itself buys almost nothing at this alpha."
              },
              "cyber": {
                "$value": "rgba( 0, 255, 65, .70 )",
                "comment": "the Game of Life on the board (§18). Cyber keeps the phosphor."
              }
