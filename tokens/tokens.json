      "$description": "boxes (notices, callouts, tabs, badges)",
      "BOX-CAPTION-color": {"$value": "{wf.palette.text-strong}"},
      "BOX-BG-color": {"$value": "{wf.bloom.fill}"},
      "BOX-TEXT-color": {"$value": "{wf.palette.text}"},
      "BOX-BLUE-color": {
        "$value": "{wf.palette.chrome}",
        "$extensions": {
          "csc": {
            "comment": "NOTE the split: *-color is used as a FILL (white caption sits on it) and *-TEXT-color is used as TEXT on the dark ground. FAU red at #CC0000 is 3.4:1 as text and fails AA — hence --BOX-RED-TEXT-color is the lifted red."
          }
        }
      },
      "BOX-BLUE-TEXT-color": {"$value": "{wf.palette.chrome}"},
